# 复制为 .env.worker 后填写；不要把真实 token 提交到 Git。
MEDIA_ARCHIVE_CONTROLLER_URL=https://kol-auto.zeabur.app
INTERNAL_TOKEN=
MEDIA_ARCHIVE_WORKER_ID=old-terminal-grey
MEDIA_ARCHIVE_WORK_ROOT=D:/kol_media_archive/work
MEDIA_ARCHIVE_POLL_SECONDS=120
# 忙碌时持续续报；必须明显短于云端10分钟掉线判断。
MEDIA_ARCHIVE_HEARTBEAT_SECONDS=120

# 可执行文件。放入 PATH 时可只写命令名。
MEDIA_ARCHIVE_PYTHON=python.exe
YTDLP_BIN=yt-dlp.exe
FFMPEG_BIN=ffmpeg.exe
FFPROBE_BIN=ffprobe.exe
LARK_CLI_BIN=lark-cli.exe
LARK_CLI_PROFILE=

# TikTok / Instagram 需要美国节点；YouTube 也可复用同一显式代理。
KOL_SCRAPER_PROXY=http://127.0.0.1:7890

# 长期后台任务优先使用导出的 Netscape cookies 文件，不依赖浏览器登录用户。
MEDIA_ARCHIVE_COOKIES_FILE=D:/kol_media_archive/private/social-cookies.txt
MEDIA_ARCHIVE_COOKIES_BROWSER=
